{
  "name": "pokyra-launcher",
  "version": "1.0.0",
  "description": "Launcher officiel ultra-premium pour le serveur Pixelmon Pokyra",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/sync-dev-mods.js",
    "start": "electron .",
    "start:dev": "powershell -ExecutionPolicy Bypass -File ..\\forge_extracted\\compile_pokyraforms.ps1 && node scripts/sync-dev-mods.js && electron .",
    "sync-mods": "node scripts/sync-dev-mods.js",
    "dist": "electron-builder"
  },
  "keywords": [
    "minecraft",
    "pixelmon",
    "launcher",
    "electron"
  ],
  "author": "Pokyra",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.4.16",
    "minecraft-launcher-core": "*",
    "msmc": "*"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pokyra.launcher",
    "productName": "Pokyra",
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "Pokyra-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Pokyra",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!dist",
      "!.git"
    ]
  }
}
